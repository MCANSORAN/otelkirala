# MongoDB bağlantı adresi. MongoDB Atlas'ta ücretsiz bir cluster oluşturup
# "Connect > Drivers" adımından aldığınız connection string'i buraya yapıştırın.
# Örnek: mongodb+srv://kullanici:sifre@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Kullanılacak veritabanı adı (opsiyonel, varsayılan: otelkirala)
MONGODB_DB=otelkirala

# Admin paneli giriş bilgileri
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Oturum cookie'lerini imzalamak için kullanılan gizli anahtar.
# Üretmek için: openssl rand -base64 32
SESSION_SECRET=

# Sitenin herkese açık adresi. Open Graph / sosyal paylaşım görsellerinin ve
# metadataBase'in mutlak URL üretmesi için kullanılır. Tanımsızsa http://localhost:3000
# varsayılır. Örnek (üretim): https://otelkirala.com
NEXT_PUBLIC_SITE_URL=
